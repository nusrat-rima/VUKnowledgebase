# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. GOOGLE GEMINI API KEY
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 2. ADMIN PANEL AUTHENTICATION
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=super-secret-jwt-key-replace-with-random-32-chars

# 3. VECTOR DATABASE CONFIGURATION
# Choose one of: 'neon' | 'pinecone' | 'upstash' | 'supabase' | 'qdrant' | 'local'
VECTOR_DB_PROVIDER=neon

# ------------------------------------------------------------------------------
# OPTION A: NEON SERVERLESS POSTGRES (https://neon.tech)
# ------------------------------------------------------------------------------
NEON_DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# OPTION B: PINECONE (https://pinecone.io)
# ------------------------------------------------------------------------------
# VECTOR_DB_PROVIDER=pinecone
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX=gemini-embeddings
# PINECONE_HOST=https://gemini-embeddings-xxxx.svc.aped-4627-b74a.pinecone.io

# ------------------------------------------------------------------------------
# OPTION C: UPSTASH VECTOR (https://upstash.com/vector)
# ------------------------------------------------------------------------------
# VECTOR_DB_PROVIDER=upstash
# UPSTASH_VECTOR_REST_URL=https://xxxx-vector.upstash.io
# UPSTASH_VECTOR_REST_TOKEN=your_upstash_token_here

# ------------------------------------------------------------------------------
# OPTION D: SUPABASE / POSTGRESQL (pgvector)
# ------------------------------------------------------------------------------
# VECTOR_DB_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_TABLE=document_embeddings

# ------------------------------------------------------------------------------
# OPTION E: QDRANT (https://cloud.qdrant.io)
# ------------------------------------------------------------------------------
# VECTOR_DB_PROVIDER=qdrant
# QDRANT_URL=https://your-cluster-url.qdrant.tech:6333
# QDRANT_API_KEY=your_qdrant_api_key
# QDRANT_COLLECTION=gemini_documents

# ------------------------------------------------------------------------------
# OPTION F: LOCAL / IN-MEMORY (Built-in Zero Config Mode)
# ------------------------------------------------------------------------------
# VECTOR_DB_PROVIDER=local
